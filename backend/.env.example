# Rails
RAILS_ENV=development
PORT=3000
RAILS_MAX_THREADS=5

# Database
# Prefer DATABASE_URL in production. For local development the defaults in
# config/database.yml are usually enough.
# DATABASE_URL=postgres://localhost/tvt_backend_development
TVT_BACKEND_DATABASE_PASSWORD=

# Harvest source location
# Override if ../tvt-harvest is not the correct sibling path.
TVT_HARVEST_ROOT=

# CORS
# Leave empty for same-origin deployments.
# Example: https://app.example.com,https://staging.example.com
TVT_ALLOWED_ORIGINS=
